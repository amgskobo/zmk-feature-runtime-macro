# NAME_MAX_LEN permits 32 content bytes; nanopb strings also need a NUL byte.
cormoran.runtime_macro.MacroSummary.name       max_length:32
cormoran.runtime_macro.MacroDetail.name        max_size:33
cormoran.runtime_macro.CreateMacroRequest.name max_size:33
cormoran.runtime_macro.DeleteMacroRequest.name max_size:33
cormoran.runtime_macro.RenameMacroRequest.old_name max_size:33
cormoran.runtime_macro.RenameMacroRequest.new_name max_size:33
# Streamed at encode time by a pb_callback_t (see encode_macro_steps_cb) so a
# full macro is never materialized as a steps[64] array (~4.6 KB) in the
# response buffer. Wire format is unchanged (repeated MacroStep).
cormoran.runtime_macro.MacroDetail.steps       type:FT_CALLBACK
cormoran.runtime_macro.KeyTapSequenceStep.packed_keys max_size:64
cormoran.runtime_macro.ErrorResponse.message   max_size:96
cormoran.runtime_macro.StatusResponse.message  max_size:96
cormoran.runtime_macro.ListMacrosResponse.macros max_count:16
# The module's iterator produces only slots0..COUNT-1, with COUNT<=16.
# Keep request slots, body parameters and encoded_size at their full wire width.
cormoran.runtime_macro.MacroSummary.slot       int_size:IS_8
